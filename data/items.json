  "trainingPlan": {
    "title": "童軍支部的訓練計劃 (2017第1次修訂版 + 2026專科更新)",
    "purpose": "童軍支部(11-16歲)旨在促進身心精神陶冶，透過進度性獎章及專科徽章制度，配合小隊制度，從實踐中學習",
    "method": [
      "小隊制度：小隊為基本單位，由隊長帶領",
      "進度性獎章：探索→標準→高級→總領袖，循序漸進",
      "專科徽章：興趣組(綠底，旅團考，領袖剔)、技能組(藍底，區考，成員填日子領袖審批)、服務組(紅底，區考)、教導組(黃底，考獲3個月後教授他人)"
    ],
    "expected": [
      "德智體群美靈六育發展",
      "小隊合作及領導",
      "戶外技能及服務"
    ],
    "progressFlow": "會員章→探索獎章→標準獎章→高級獎章→總領袖獎章",
    "assessmentPrinciples": "會員章及興趣組由旅團團長主考，技能組/服務組/教導組及高級以上由區會安排主考。興趣組領袖直接剔/填日子，其他由成員填日子領袖審批=知會。",
    "links": [
      {"title": "童軍資訊站 - 2026專科徽章更新", "url": "https://scoutsinfohub.org.hk/notice/tong-jun-zhi-bu-zhuan-ke-hui-zhang-geng-xin"},
