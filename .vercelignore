# Repository and local tooling
.git
.github
.gitignore
node_modules
.vercel
.cache
.npm
.yarn
.pnpm-store

# Tests, reports and local artifacts
test
tests
coverage
*.log
*.tmp
*.temp
.tmp
tmp
temp
uploads
backup
backups

# Source/documentation not needed by the deployed application
# (`apps-script/Code.gs` must stay uploadable: build.js publishes it as the
#  official "⬇️ 下載 Code.gs" download in the setup steps)
apps-script/*
!apps-script/Code.gs
server.js
README.md
APP_ADMIN_WORKFLOW.md
TROOP_ONBOARDING.md
VERCEL_ENV_SETUP.md
DEPLOYMENT_HYGIENE.md
scripts

# Operational runbooks (Git-only): troop-link spec kept out of the deployed site
operations

# Development-only files
.env
.env.*
!.env.example
